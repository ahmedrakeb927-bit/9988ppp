{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile for students and the exclusive administrator (Prof. Redouane Rakeb).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"]
        },
        "educationalLevel": {
          "type": "string",
          "enum": ["1bac", "2bac", "admin"]
        },
        "branch": {
          "type": "string",
          "enum": ["Sciences", "Arts and Humanities", "Administration"]
        },
        "group": {
          "type": "string",
          "enum": ["G1", "G2", "G3", "G4", "ALL"]
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "pending_verification", "suspended"]
        },
        "notificationPreferences": {
          "type": "object"
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["ar", "fr"]
        },
        "isSelfDeclared": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "role",
        "educationalLevel",
        "branch",
        "group",
        "accountStatus",
        "notificationPreferences",
        "preferredLanguage",
        "isSelfDeclared",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
