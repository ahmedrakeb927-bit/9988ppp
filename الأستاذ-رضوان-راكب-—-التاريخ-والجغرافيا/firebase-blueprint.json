  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Student and administrator profiles isolated by UID."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Exclusive administrator lookup registry."
    },
    "/websiteSettings/{settingId}": {
      "schema": { "$ref": "#/entities/WebsiteSettings" },
      "description": "Global platform configuration."
    },
    "/educationalStructure/{structureId}": {
      "schema": { "$ref": "#/entities/EducationalStructure" },
      "description": "Official educational levels, branches, and groups."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/CmsSubject" },
      "description": "Subjects collection (History and Geography + custom subjects)."
    },
    "/units/{unitId}": {
      "schema": { "$ref": "#/entities/CmsUnit" },
      "description": "Flexible hierarchical units, chapters, and custom categories."
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/CmsLesson" },
      "description": "Rich-text educational lessons with version history and group targeting."
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/CmsResource" },
      "description": "Protected educational resources and file metadata."
    },
    "/examinations/{examId}": {
      "schema": { "$ref": "#/entities/CmsExamination" },
      "description": "Examinations and exercises with group audience targeting."
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/AcademicContentItem" },
      "description": "Academic announcements collection."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationRecord" },
      "description": "User notification records."
    },
    "/adminActivityLogs/{logId}": {
      "schema": { "$ref": "#/entities/AdminActivityLog" },
      "description": "Administrative activity audit logs."
    }
  }
}
